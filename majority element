class Solution(object):
    def majorityElement(self, nums):
        n = len(nums)
        count = 0
        el = 0
        for i in range(0,n):
            if count == 0:
                count = 1
                el = nums[i]
            elif nums[i] == el:
                count += 1
            else :
                count -= 1
        count1 = 0
        for i in range(0,n):
            if nums[i] == el:
                count1 += 1
        if count1 > n/2:
            return el
    
