def longestSubarrayWithSumK(a: [int], k: int) -> int:
    # Write your code here
    right = 0
    left = 0
    n = len(a)
    sumi = a[0]
    max_len = 0
    while right < n:
        while left <= right and sumi > k:
            sumi -= a[left]
            left += 1
        if sumi == k:
            max_len = max(max_len,right - left + 1)
        right += 1
        if right < n:
            sumi += a[right]
    return max_len


    
