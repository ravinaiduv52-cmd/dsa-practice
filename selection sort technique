arr = [5, 4, 3, 2, 1]
n = len(arr)


def selection_sort():
    for i in range(0, n - 1):
        mini = i
        for j in range(i, n):
            if arr[j] < arr[mini]:
                mini = j
        temp = arr[i]
        arr[i] = arr[mini]
        arr[mini] = temp
    print(arr)


selection_sort()
