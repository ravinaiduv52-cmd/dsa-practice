def print_all_subsets_equal_to_target(ind, temp, s, arr, n, target):
    if ind == n:
        if s == target:
            print(temp)
        return
    temp.append(arr[ind])
    s += arr[ind]
    print_all_subsets_equal_to_target(ind+1, temp, s, arr, n, target)
    temp.remove(arr[ind])
    s -= arr[ind]
    print_all_subsets_equal_to_target(ind+1, temp, s, arr, n, target)


def print_one_subset_equal_to_target(ind, temp, s, arr, n, target):
    if s == target:
        print(temp)
        return True
    if ind == n:
        return False
    temp.append(arr[ind])
    if print_one_subset_equal_to_target(ind+1, temp, s+arr[ind], arr, n, target):
        return True
    temp.remove(arr[ind])
    return print_one_subset_equal_to_target(ind+1, temp, s, arr, n, target)


def count_subsets_equal_to_target(ind, temp, s, arr, n, target):
    if ind == n:
        if s == target:
            return 1
        return 0
    temp.append(arr[ind])
    s += arr[ind]
    l = count_subsets_equal_to_target(ind+1, temp, s, arr, n, target)
    temp.remove(arr[ind])
    s -= arr[ind]
    r = count_subsets_equal_to_target(ind+1, temp, s, arr, n, target)
    return l + r


if __name__ == "__main__":
    arr = [1, 2, 1]
    n = len(arr)
    target = 2

    print_all_subsets_equal_to_target(0, [], 0, arr, n, target)
    print_one_subset_equal_to_target(0, [], 0, arr, n, target)
    print(count_subsets_equal_to_target(0, [], 0, arr, n, target))
