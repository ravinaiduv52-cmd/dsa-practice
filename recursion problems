def numbers(n, i):
    if n < i:
        return None
    else:
        numbers(n - 1, i)
        print(n, end=" ")


def total(n):
    if n == 0:
        return 0
    return n + total(n - 1)


def fact(n):
    if n == 0:
        return 1
    return n * fact(n - 1)


if __name__ == "__main__":
    n = int(input("Enter numbers to be printed : "))
    numbers(n, 1)
    print()

    n = int(input("Enter the sum of numbers : "))
    print(total(n))

    n = 4
    print(fact(n))
