class Solution(object):
    def maxSubArray(self, nums):
        maxi = nums[0]
        sumi = 0
        n = len(nums)
        for i in range(0,n):
            if sumi == 0:
                start = i
            sumi = sumi + nums[i]
            if sumi > maxi :
                maxi = sumi 
                ans_start = start
                ans_end = i
            if sumi < 0:
                sumi = 0
        return maxi
