def func(n,arr):
    count = 0
    for i in range(0,len(arr)):
        if arr[i] == n:
            count += 1
    return count
arr = [1,2,1,3,2]
print(func(1,arr))


def func(char_c,s):
    count = 0
    for i in range(0,len(s)):
        if s[i] == char_c:
            count += 1
    return count
char_c = ["a","b","c","d","e","f","g","h","i","g"]
print(func("g",char_c))


