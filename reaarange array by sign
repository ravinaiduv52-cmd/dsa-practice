class Solution(object):
    def rearrangeArray(self, nums):
        pos = []
        neg = []
        n = len(nums)
        for x in nums :
            if x > 0:
                pos.append(x)
            else :
                neg.append(x)
        for i in range(n//2):
            nums[i*2] = pos[i]
            nums[i*2+1] = neg[i]
        return nums
        
