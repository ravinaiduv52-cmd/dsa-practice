class Solution:
    def intersectionArray(self, nums1, nums2):
        n1 = len(nums1)
        n2 = len(nums2)
        ans = []
        visi = [0] * n2
        for i in range(0,n1):
            for j in range(0,n2):
                if nums1[i] == nums2[j] and visi[j] == 0:
                    ans.append(nums1[i])
                    visi[j] = 1
                    break
                if nums2[j] > nums1[i] :
                    break
        return ans
        
