class Solution:
    def intersectionArray(self, nums1, nums2):
        i = 0
        j = 0
        n = len(nums1)
        m = len(nums2)
        ans = []
        while i < n and j < m:
            if nums1[i] < nums2[j] :
                i += 1
            elif nums2[j] < nums1[i] :
                j += 1
            else :
                ans.append(nums1[i])
                i += 1
                j += 1
        return ans
        
